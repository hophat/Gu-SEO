{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gulagi-cron-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-05-18",

  // ONE trigger drives everything. A single */15 schedule means the social
  // retry queue is drained every 15 minutes (its backoff ladder is 1m → 2m
  // → 4m → 8m…), and it uses 1 of the account-wide 5-trigger cap instead of
  // 3. The worker decides what to run from the invocation's UTC hour:
  //   01:00  daily blog post per project (08:00 Vietnam time)
  //   09:00  programmatic-SEO batch (up to 10 pages per project)
  //   Mon 07:00  weekly content refresh (up to 2 rewrites per project)
  // Override the hours with BLOG_HOUR / PROG_HOUR / REFRESH_HOUR secrets.
  //
  // Secrets:
  //   BLOG_URL    — https://<host>/api/admin/blog (tick URL derived from it)
  //   ADMIN_TOKEN — shared bearer token
  //   TICK_URL    — optional explicit https://<host>/api/admin/cron/tick

  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },

  // Keep a queryable log of each run. Without it a fan-out that only
  // processed part of the project list looks identical to a healthy run —
  // which is how a 3-day outage went unnoticed.
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
