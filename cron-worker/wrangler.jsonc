{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gulagi-cron-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-05-18",

  // Triggers (kept to 3 to fit the account-wide 5-trigger cap on
  // Cloudflare's free / Workers Paid base plan). Every schedule makes a
  // single call to /api/admin/cron/tick, which fans the task out across
  // all active projects:
  //   0 1 * * *  → daily blog post per project at 08:00 Vietnam time
  //                (UTC+7). Skips projects that already produced one
  //                today; approval-mode projects stop at the draft stage
  //                for a human click.
  //   0 9 * * *  → programmatic-SEO batch (up to 10 pages per project).
  //   0 7 * * 1  → weekly content refresh (up to 2 rewrites per project).
  //
  // Secrets:
  //   BLOG_URL    — https://<host>/api/admin/blog (tick URL derived from it)
  //   ADMIN_TOKEN — shared bearer token
  //   TICK_URL    — optional explicit https://<host>/api/admin/cron/tick

  "triggers": {
    "crons": [
      "0 1 * * *",
      "0 9 * * *",
      "0 7 * * 1"
    ]
  }
}
